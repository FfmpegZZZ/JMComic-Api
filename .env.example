# Server-side configuration. Copy to `.env` and edit.
# All keys are prefixed `JMAPI_` so they don't collide with other tooling.

# Where uvicorn binds.
JMAPI_HOST=0.0.0.0
JMAPI_PORT=8699

# jmcomic library config (the file watched by SIGHUP for hot reload).
JMAPI_OPTION_FILE=./option.yml

# Where generated PDFs are cached.
JMAPI_PDF_DIR=./pdf

# Logging — `console` for dev (colorized), `json` for production.
JMAPI_LOG_FORMAT=console
JMAPI_LOG_LEVEL=INFO

# Comma-separated origins; empty disables CORS entirely.
# JMAPI_CORS_ORIGINS=["https://reader.example.com"]

# Requests slower than this emit a `slow_request` warning event.
JMAPI_SLOW_REQUEST_THRESHOLD_SECONDS=5.0
