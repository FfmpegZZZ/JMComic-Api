# Server-side configuration. Copy to `.env` and edit.
# All keys are prefixed `JMAPI_` so they don't collide with other tooling.

# Where uvicorn binds.
JMAPI_HOST=0.0.0.0
JMAPI_PORT=8699

# jmcomic library config (the file watched by SIGHUP for hot reload).
JMAPI_OPTION_FILE=./option.yml

# Where generated PDFs are cached.
JMAPI_PDF_DIR=./pdf

# Logging — `console` for dev (colorized), `json` for production.
JMAPI_LOG_FORMAT=console
JMAPI_LOG_LEVEL=INFO

# Comma-separated origins; empty disables CORS entirely.
# JMAPI_CORS_ORIGINS=["https://reader.example.com"]

# Requests slower than this emit a `slow_request` warning event.
JMAPI_SLOW_REQUEST_THRESHOLD_SECONDS=5.0

# Independent lanes and bounded waiting (single process deployment).
JMAPI_MAX_CONCURRENT_DOWNLOADS=3
JMAPI_MAX_CONCURRENT_METADATA=8
JMAPI_MAX_CONCURRENT_PDF_BUILDS=1
JMAPI_MAX_CONCURRENT_BASE64=1
# Encoding concurrency above is separate from admitted response streams.
JMAPI_MAX_CONCURRENT_BASE64_STREAMS=4
# Maximum time a single ASGI send may stall; active transfers can run longer.
JMAPI_RESPONSE_SEND_TIMEOUT_SECONDS=30
JMAPI_CHAPTER_THREADS=3
JMAPI_IMAGE_THREADS=12
JMAPI_QUEUE_CAPACITY=32
JMAPI_QUEUE_TIMEOUT_SECONDS=30
JMAPI_LOCK_ACQUIRE_TIMEOUT_SECONDS=600
JMAPI_DOWNLOAD_TIMEOUT_SECONDS=600
JMAPI_PDF_BUILD_TIMEOUT_SECONDS=300
JMAPI_METADATA_TIMEOUT_SECONDS=30
JMAPI_SHUTDOWN_GRACE_SECONDS=30
JMAPI_MIN_FREE_DISK_MB=500
JMAPI_PDF_SHARD_CACHE_DIR=./pdf_cache
JMAPI_PAGE_CACHE_MB=512
JMAPI_JPEG_OPTIMIZE=true
# Both query TTLs are disabled by default; suggested opt-in values: 30 / 300.
JMAPI_QUERY_CACHE_TTL_SECONDS=0
JMAPI_DETAIL_CACHE_TTL_SECONDS=0
# Optional PDF eviction can invalidate previously returned absolute paths.
JMAPI_PDF_CACHE_TTL_SECONDS=0
JMAPI_PDF_CACHE_MAX_MB=0
JMAPI_CLEANUP_INTERVAL_SECONDS=3600

# Optional personal JM accounts. Credentials (including passwords) are encrypted.
JMAPI_AUTH_ENABLED=false
JMAPI_AUTH_STATE_DIR=./state/sessions
# Required when enabled: file containing exactly 32 random bytes.
# JMAPI_AUTH_KEY_FILE=./secrets/session.key
JMAPI_AUTH_SESSION_TTL_SECONDS=604800
JMAPI_AUTH_SESSION_IDLE_SECONDS=86400
JMAPI_AUTH_MAX_SESSIONS=256
JMAPI_AUTH_MAX_RUNTIMES=32
JMAPI_AUTH_LOGIN_TIMEOUT_SECONDS=30
